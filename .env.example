APP_NAME="Quick SEO Analysis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quick_seo_analysis
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="reports@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://qsa.vervelogic.com/auth/google/callback

QSA_SCAN_TIMEOUT=12
QSA_SCAN_CONNECT_TIMEOUT=8
QSA_SCAN_MAX_BYTES=2097152
QSA_SCAN_RATE_LIMIT_PER_MINUTE=6
QSA_AUTH_SCAN_RATE_LIMIT_PER_MINUTE=20
QSA_LEAD_RATE_LIMIT_PER_MINUTE=10
QSA_DEFAULT_COMPANY_NAME="Quick SEO Analysis"
QSA_DAILY_ANONYMOUS_SCAN_QUOTA=5
QSA_DUPLICATE_SCAN_COOLDOWN_MINUTES=30
QSA_VERIFICATION_TRIGGER_AFTER_ABUSE_EVENTS=3
QSA_VERIFICATION_LOCK_HOURS=12
QSA_SCAN_DAILY_QUOTA_MESSAGE="You have reached the free daily scan limit for this connection. Please sign in to continue."
QSA_SCAN_DUPLICATE_MESSAGE="This URL was already scanned recently from this connection. Please wait before scanning it again."
QSA_SCAN_VERIFICATION_MESSAGE="Too many anonymous scan attempts were detected. Please sign in with Google or use your client login to continue."
